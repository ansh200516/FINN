# FINN — copy to .env.local (gitignored). Every variable is optional except
# DATABASE_URL, which defaults to the local SQLite file. The app boots with
# nothing set; LLM features then serve from llm_cache only.

# --- LLM (Gemini Developer API, free tier) ----------------------------------
GEMINI_API_KEY=                      # https://aistudio.google.com/apikey
# FINN_MODELS_BULK=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# FINN_MODELS_REASON=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash
# FINN_LLM_CACHE_ONLY=true           # demo safety: never call the API
# Finnie tries these after Gemini on quota, 429, a credit 403, 503, or a daily cap.
# An empty value skips that provider. Do not put a real key here.
GROQ_API_KEY=                        # Free tier: openai/gpt-oss-20b, about 30 RPM and 1,000 requests/day. https://console.groq.com/keys
OPENROUTER_API_KEY=                  # Free models router (openrouter/free): rate-limited and $0, no paid fallthrough. https://openrouter.ai/keys
CEREBRAS_API_KEY=                    # Shared Inference free-trial credits for qwen-3.8-27b; access stops when the credits run out. https://cloud.cerebras.ai

# --- Database ----------------------------------------------------------------
DATABASE_URL=file:./data/finn.db     # prod: postgres:// or postgresql:// (Supabase). libsql:// still works with DATABASE_AUTH_TOKEN.
DATABASE_AUTH_TOKEN=                 # Turso token only. Unused for Postgres.

# --- Jobs / cron ---------------------------------------------------------------
JOBS_SECRET=                         # bearer for /api/jobs/*; set CRON_SECRET to the same value on Vercel
# FINN_REFRESH_ON_VISIT=true          # on Vercel: stale brief schedules a rules-only announcements refresh

# --- Web Push (generate once: npx web-push generate-vapid-keys) ----------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=        # same as VAPID_PUBLIC_KEY, exposed to the client

# --- Telegram ------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# LOG_LEVEL=info
